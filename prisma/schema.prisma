generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
}

enum ConnectionType {
  PROFILE
  PAGE
  BUSINESS
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  REVOKED
}

model User {
  id BigInt @id @default(autoincrement())
  uid String @unique @default(uuid())

  email    String @unique
  password String

  connections Connection[]
  socialPosts SocialPost[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model Connection {
  id BigInt @id @default(autoincrement())

  uid String @unique @default(uuid())
  
  user_id String
  user    User   @relation(fields: [user_id], references: [uid], onDelete: Cascade)

  original_id String // Provider identity (page_id, ig_id, linkedin_id)

  platform ConnectionPlatform
  type     ConnectionType
  status   ConnectionStatus   @default(CONNECTED)

  name  String?
  email String?

  access_token     String
  refresh_token    String?
  token_expires_at DateTime?

  metadata Json?

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, platform, original_id])
  @@index([status])

  @@map("connections")
}

model SocialPost {
  id BigInt @id @default(autoincrement())

  uid String @unique @default(uuid())
  
  user_id String
  user    User   @relation(fields: [user_id], references: [uid], onDelete: Cascade)

  connection_id String
  platform      ConnectionPlatform

  original_post_id String? // The real ID from the social platform
  post_url         String? // Direct URL to the post

  message String?
  urls    String[]

  status String @default("PUBLISHED") // e.g. PUBLISHED, DELETED, ARCHIVED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("social_posts")
}

model PlatformSetting {
  id BigInt @id @default(autoincrement())
  
  platform ConnectionPlatform @unique
  
  client_id     String
  client_secret String
  redirect_uri  String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("platform_settings")
}
